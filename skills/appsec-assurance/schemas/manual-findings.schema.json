{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/appsec-assurance/schemas/manual-findings.schema.json",
  "title": "appsec-assurance manual review input",
  "description": "Validated by `appsec.py validate` (which also enforces cross-field rules: confirmed findings need validation_steps, n/a and untested checklist items need notes, every triage decision needs a reason).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1"},
    "assessors": {"type": "array", "items": {"type": "string"}},
    "scope_reference": {"type": "string"},
    "executive_summary": {"type": "string"},
    "posture_statement": {"type": "string"},
    "threat_model": {"type": "string"},
    "notes": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "status", "confidence", "location", "evidence", "remediation"],
        "properties": {
          "id": {"type": "string"},
          "rule_id": {"type": "string"},
          "title": {"type": "string"},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "status": {"enum": ["confirmed", "suspected", "unverified", "missing-control", "false-positive", "accepted-risk", "fixed"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "category": {"type": "string"},
          "cwe": {"type": "array", "items": {"type": "string", "pattern": "^CWE-[0-9]+$"}},
          "owasp": {"type": "array", "items": {"type": "string"}},
          "cvss_vector": {"type": "string"},
          "location": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string"}, "start_line": {"type": "integer"}, "end_line": {"type": "integer"}, "snippet": {"type": "string"}}},
          "description": {"type": "string"},
          "evidence": {"type": "string"},
          "impact": {"type": "string"},
          "validation_steps": {"type": "array", "items": {"type": "string"}},
          "remediation": {"type": "string"},
          "patch": {"type": "string"},
          "regression_test": {"type": "string"},
          "references": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "triage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["status", "reason"],
        "properties": {
          "fingerprint": {"type": "string"}, "id": {"type": "string"},
          "status": {"enum": ["confirmed", "suspected", "false-positive", "accepted-risk", "fixed", "missing-control"]},
          "reason": {"type": "string", "minLength": 1},
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "attack_paths": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "title", "steps", "severity", "narrative"],
                "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "steps": {"type": "array", "items": {"type": "string"}},
                               "severity": {"enum": ["critical", "high", "medium", "low", "info"]}, "narrative": {"type": "string"}}}
    },
    "checklist_results": {
      "type": "array",
      "items": {"type": "object", "required": ["checklist", "item", "result"],
                "properties": {"checklist": {"type": "string"}, "item": {"type": "string"}, "result": {"enum": ["pass", "fail", "n/a", "untested"]}, "notes": {"type": "string"}}}
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
