{
  "pack": "auth",
  "version": "1.0.0",
  "description": "Built-in auth rules for appsec-assurance.",
  "rules": [
    {
      "id": "AUTH-JWT-ALG-NONE",
      "title": "JWT 'none' algorithm accepted or emitted",
      "severity": "critical",
      "confidence": "high",
      "category": "authentication",
      "files": [
        "*.py",
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.tsx",
        "*.vue",
        "*.svelte",
        "*.java",
        "*.kt",
        "*.go",
        "*.php",
        "*.rb",
        "*.erb",
        "*.cs",
        "*.cshtml",
        "*.rs"
      ],
      "remediation": "Pin the expected algorithm list (e.g. algorithms=[\"RS256\"]) and reject 'none'.",
      "pattern": "(?i)(algorithms?\\s*[:=]\\s*\\[?[^\\]\\n]*[\\\"']none[\\\"']|[\\\"']alg[\\\"']\\s*:\\s*[\\\"']none[\\\"'])",
      "cwe": [
        "CWE-347"
      ],
      "owasp": [
        "A02:2021",
        "A07:2021"
      ],
      "cvss": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N"
    },
    {
      "id": "AUTH-JWT-VERIFY-DISABLED",
      "title": "JWT signature or expiry verification disabled",
      "severity": "high",
      "confidence": "high",
      "category": "authentication",
      "files": [
        "*.py",
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.tsx",
        "*.vue",
        "*.svelte",
        "*.java",
        "*.kt",
        "*.go",
        "*.php",
        "*.rb",
        "*.erb",
        "*.cs",
        "*.cshtml",
        "*.rs"
      ],
      "remediation": "Always verify signature, exp, nbf, iss and aud.",
      "pattern": "[\\\"']?verify_signature[\\\"']?\\s*:\\s*False|jwt\\.decode\\([^)]*verify\\s*=\\s*False|ignoreExpiration\\s*:\\s*true|[\\\"']verify_exp[\\\"']\\s*:\\s*False|\\.parseUnsecuredClaims|setSkipSignatureVerification|ValidateLifetime\\s*=\\s*false|ValidateIssuerSigningKey\\s*=\\s*false|RequireSignedTokens\\s*=\\s*false",
      "cwe": [
        "CWE-347"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "AUTH-JWT-DECODE-NO-VERIFY-JS",
      "title": "jsonwebtoken decode() does not verify signatures",
      "severity": "medium",
      "confidence": "low",
      "category": "authentication",
      "files": [
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.tsx",
        "*.vue",
        "*.svelte"
      ],
      "remediation": "Use jwt.verify(token, key, { algorithms: [...] }) for any trust decision.",
      "pattern": "\\bjwt\\.decode\\(",
      "negative": "verify",
      "cwe": [
        "CWE-347"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "AUTH-JWT-HARDCODED-SECRET",
      "title": "JWT signed/verified with hardcoded secret",
      "severity": "high",
      "confidence": "medium",
      "category": "authentication",
      "files": [
        "*.py",
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.tsx",
        "*.vue",
        "*.svelte",
        "*.java",
        "*.kt",
        "*.go",
        "*.php",
        "*.rb",
        "*.erb",
        "*.cs",
        "*.cshtml",
        "*.rs"
      ],
      "remediation": "Load signing keys from a secrets manager; prefer asymmetric keys; rotate the exposed secret.",
      "pattern": "jwt\\.(sign|encode|verify|decode)\\([^\\n]*?,\\s*[\\\"'](?P<secret>[^\\\"']{4,})[\\\"']",
      "secret": true,
      "cwe": [
        "CWE-798",
        "CWE-321"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "AUTH-INSECURE-COOKIE-FLAGS",
      "title": "Session/auth cookie without Secure/HttpOnly",
      "severity": "medium",
      "confidence": "medium",
      "category": "session",
      "files": [
        "*.py",
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.tsx",
        "*.vue",
        "*.svelte",
        "*.java",
        "*.kt",
        "*.go",
        "*.php",
        "*.rb",
        "*.erb",
        "*.cs",
        "*.cshtml",
        "*.rs"
      ],
      "remediation": "Set Secure, HttpOnly and SameSite=Lax/Strict on session and auth cookies.",
      "pattern": "(?i)http_?only[\\\"']?\\s*[:=]\\s*(false|0)\\b|\\bsecure[\\\"']?\\s*:\\s*false\\b|SESSION_COOKIE_(SECURE|HTTPONLY)\\s*=\\s*False|CSRF_COOKIE_SECURE\\s*=\\s*False|cookie_secure\\s*=\\s*false|sameSite\\s*:\\s*[\\\"']?none",
      "cwe": [
        "CWE-614",
        "CWE-1004"
      ],
      "owasp": [
        "A05:2021",
        "A07:2021"
      ]
    },
    {
      "id": "AUTH-CSRF-DISABLED",
      "title": "CSRF protection disabled",
      "severity": "medium",
      "confidence": "medium",
      "category": "csrf",
      "files": [
        "*.py",
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.tsx",
        "*.vue",
        "*.svelte",
        "*.java",
        "*.kt",
        "*.go",
        "*.php",
        "*.rb",
        "*.erb",
        "*.cs",
        "*.cshtml",
        "*.rs"
      ],
      "remediation": "Keep CSRF protection on for cookie-authenticated state-changing routes; exempt only token-authenticated APIs with justification.",
      "pattern": "@csrf_exempt|\\bcsrf_exempt\\(|csrf\\(\\)\\.disable\\(\\)|csrf\\(\\s*\\w+\\s*->\\s*\\w+\\.disable\\(\\)\\s*\\)|csrf\\s*\\{\\s*disable\\(\\)|skip_before_action\\s+:verify_authenticity_token|protect_from_forgery\\s+with:\\s*:null_session|WTF_CSRF_ENABLED\\s*=\\s*False|\\[IgnoreAntiforgeryToken\\]|csrf\\s*:\\s*false",
      "cwe": [
        "CWE-352"
      ],
      "owasp": [
        "A01:2021"
      ]
    },
    {
      "id": "AUTH-PLAINTEXT-PASSWORD-COMPARE",
      "title": "Password compared in plaintext",
      "severity": "high",
      "confidence": "low",
      "category": "authentication",
      "files": [
        "*.py",
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.tsx",
        "*.vue",
        "*.svelte",
        "*.java",
        "*.kt",
        "*.go",
        "*.php",
        "*.rb",
        "*.erb",
        "*.cs",
        "*.cshtml",
        "*.rs"
      ],
      "remediation": "Store a salted adaptive hash and use the library's constant-time verify function.",
      "pattern": "(?i)\\b\\w*passw(or)?d\\w*\\s*(===?|!==?)\\s*\\w*\\.?(body|params|query|form|args|json|data|input|request)\\b|\\b(body|form|args|params|json)\\W+\\w*passw(or)?d\\w*\\W*\\s*(===?|!==?)\\s*\\w*(user|row|record|account|db)\\.\\w*passw",
      "cwe": [
        "CWE-256",
        "CWE-208"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "AUTH-ALLOW-ANY",
      "title": "Endpoint explicitly allows unauthenticated access",
      "severity": "medium",
      "confidence": "low",
      "category": "authorization",
      "files": [
        "*.py",
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.tsx",
        "*.vue",
        "*.svelte",
        "*.java",
        "*.kt",
        "*.go",
        "*.php",
        "*.rb",
        "*.erb",
        "*.cs",
        "*.cshtml",
        "*.rs"
      ],
      "remediation": "Confirm the endpoint is intended to be public and exposes no sensitive data or actions; default-deny elsewhere.",
      "pattern": "permission_classes\\s*=\\s*[\\[(]\\s*AllowAny|@permission_classes\\(\\s*\\[\\s*AllowAny|anyRequest\\(\\)\\.permitAll\\(\\)|\\[AllowAnonymous\\]|@PermitAll\\b|skip_before_action\\s+:authenticate",
      "cwe": [
        "CWE-862"
      ],
      "owasp": [
        "A01:2021"
      ]
    },
    {
      "id": "AUTH-BCRYPT-LOW-COST",
      "title": "bcrypt cost factor below 10",
      "severity": "medium",
      "confidence": "medium",
      "category": "authentication",
      "files": [
        "*.py",
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.tsx",
        "*.vue",
        "*.svelte",
        "*.java",
        "*.kt",
        "*.go",
        "*.php",
        "*.rb",
        "*.erb",
        "*.cs",
        "*.cshtml",
        "*.rs"
      ],
      "remediation": "Use a cost of at least 12 (benchmark for ~250ms per hash).",
      "pattern": "gensalt\\(\\s*(rounds\\s*=\\s*)?[4-9]\\s*\\)|genSalt(Sync)?\\(\\s*[4-9]\\s*[,)]|bcrypt\\.hash(Sync)?\\([^,]+,\\s*[4-9]\\s*[,)]|GenerateFromPassword\\([^,]+,\\s*[4-9]\\s*\\)",
      "cwe": [
        "CWE-916"
      ],
      "owasp": [
        "A02:2021"
      ]
    },
    {
      "id": "AUTH-MASS-ASSIGNMENT",
      "title": "Request body bound directly to a model",
      "severity": "medium",
      "confidence": "medium",
      "category": "authorization",
      "files": [
        "*.py",
        "*.js",
        "*.mjs",
        "*.cjs",
        "*.jsx",
        "*.ts",
        "*.tsx",
        "*.vue",
        "*.svelte",
        "*.java",
        "*.kt",
        "*.go",
        "*.php",
        "*.rb",
        "*.erb",
        "*.cs",
        "*.cshtml",
        "*.rs"
      ],
      "remediation": "Bind an explicit allowlist of fields (DTO/serializer fields/strong params); never let clients set role, owner, price, or tenant.",
      "pattern": "\\.(create|update|insert|build|findByIdAndUpdate|updateOne|save)\\(\\s*(\\{\\s*\\.\\.\\.)?req\\.body\\s*[,)}]|Object\\.assign\\(\\s*\\w+\\s*,\\s*req\\.body\\s*\\)|\\(\\s*\\*\\*request\\.(data|json|POST|get_json\\(\\))\\s*\\)|params\\.permit!|fields\\s*=\\s*[\\\"']__all__[\\\"']|\\$guarded\\s*=\\s*\\[\\s*\\]",
      "cwe": [
        "CWE-915"
      ],
      "owasp": [
        "A01:2021",
        "API3:2023"
      ]
    }
  ]
}
