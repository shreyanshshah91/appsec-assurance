{
  "pack": "secrets",
  "version": "1.0.0",
  "description": "Built-in secrets rules for appsec-assurance.",
  "rules": [
    {
      "id": "SEC-AWS-ACCESS-KEY",
      "title": "AWS access key ID in source",
      "severity": "high",
      "confidence": "high",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Remove the key, rotate it in IAM immediately, audit CloudTrail for its use, and load credentials from the environment, an instance/workload role, or a secrets manager.",
      "pattern": "(?<![A-Z0-9])(?P<secret>(AKIA|ASIA|ABIA|ACCA)[0-9A-Z]{16})(?![A-Z0-9])",
      "secret": true,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2021"
      ],
      "cvss": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:N",
      "description": "Hardcoded cloud credentials can be harvested from source, history, packages and build artifacts."
    },
    {
      "id": "SEC-AWS-SECRET-KEY",
      "title": "AWS secret access key assignment",
      "severity": "critical",
      "confidence": "medium",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Rotate the key pair, purge it from git history, and move to role-based credentials.",
      "pattern": "(?i)aws.?secret.?(access.?)?key\\W{0,4}\\s*[:=]\\s*[\\\"']?(?P<secret>[A-Za-z0-9/+=]{40})(?![A-Za-z0-9/+=])",
      "secret": true,
      "entropy_min": 3.5,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "SEC-PRIVATE-KEY",
      "title": "Private key material in repository",
      "severity": "high",
      "confidence": "high",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Remove the key, treat it as compromised, re-issue certificates/keys, and store keys in a KMS/HSM or secrets manager.",
      "pattern": "-----BEGIN (RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY( BLOCK)?-----",
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-321",
        "CWE-798"
      ],
      "owasp": [
        "A02:2021"
      ]
    },
    {
      "id": "SEC-GITHUB-TOKEN",
      "title": "GitHub token in source",
      "severity": "high",
      "confidence": "high",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Revoke the token in GitHub settings, review the audit log, and use GITHUB_TOKEN or a secrets store.",
      "pattern": "(?P<secret>\\b(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,}\\b|\\bgithub_pat_[A-Za-z0-9_]{60,})",
      "secret": true,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "SEC-SLACK-TOKEN",
      "title": "Slack token in source",
      "severity": "high",
      "confidence": "high",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Revoke the token and load it from a secrets manager.",
      "pattern": "(?P<secret>\\bxox[baprse]-[A-Za-z0-9-]{10,})",
      "secret": true,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "SEC-STRIPE-LIVE-KEY",
      "title": "Stripe live secret key",
      "severity": "critical",
      "confidence": "high",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Roll the key in the Stripe dashboard and restrict the replacement; never ship secret keys to clients.",
      "pattern": "(?P<secret>\\b(sk|rk)_live_[0-9a-zA-Z]{20,})",
      "secret": true,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "SEC-GOOGLE-API-KEY",
      "title": "Google API key",
      "severity": "medium",
      "confidence": "high",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Restrict the key by API and referrer/IP in Google Cloud console, rotate it, and keep unrestricted keys server-side.",
      "pattern": "(?P<secret>\\bAIza[0-9A-Za-z_\\-]{35})",
      "secret": true,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "SEC-LLM-API-KEY",
      "title": "AI provider API key (Anthropic/OpenAI)",
      "severity": "high",
      "confidence": "high",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Revoke the key in the provider console and load keys from the environment or a secrets manager.",
      "pattern": "(?P<secret>\\bsk-ant-(api|admin)\\d{2}-[A-Za-z0-9_\\-]{20,}|\\bsk-proj-[A-Za-z0-9_\\-]{20,})",
      "secret": true,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "SEC-NPM-TOKEN",
      "title": "npm access token",
      "severity": "high",
      "confidence": "high",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Revoke the token on npmjs.com and inject it at CI runtime only.",
      "pattern": "(?P<secret>\\bnpm_[A-Za-z0-9]{36}\\b)|_authToken\\s*=\\s*(?P<auth>[^\\s$]{8,})",
      "secret": true,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A08:2021"
      ]
    },
    {
      "id": "SEC-SENDGRID-KEY",
      "title": "SendGrid API key",
      "severity": "high",
      "confidence": "high",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Revoke and re-issue the key with minimal scopes.",
      "pattern": "(?P<secret>\\bSG\\.[A-Za-z0-9_\\-]{22}\\.[A-Za-z0-9_\\-]{43}\\b)",
      "secret": true,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "SEC-JWT-LITERAL",
      "title": "Hardcoded JSON Web Token",
      "severity": "medium",
      "confidence": "medium",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Remove the token; if it is long-lived or signed with a production key, rotate the signing key.",
      "pattern": "(?P<secret>\\beyJ[A-Za-z0-9_\\-]{10,}\\.eyJ[A-Za-z0-9_\\-]{10,}\\.[A-Za-z0-9_\\-]{10,})",
      "secret": true,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "SEC-CONN-STRING-CREDS",
      "title": "Credentials embedded in connection URL",
      "severity": "high",
      "confidence": "medium",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Move the connection string to a secret store / environment variable and rotate the database password.",
      "pattern": "\\b(postgres(ql)?|mysql|mariadb|mongodb(\\+srv)?|redis|rediss|amqps?|mssql|sqlserver)://[^:\\s'\\\"/@]+:(?P<secret>[^@\\s'\\\"/]{3,})@",
      "secret": true,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2021"
      ]
    },
    {
      "id": "SEC-GENERIC-ASSIGNMENT",
      "title": "Possible hardcoded secret in assignment",
      "severity": "medium",
      "confidence": "medium",
      "category": "secrets",
      "files": [
        "*"
      ],
      "remediation": "Load the value from the environment or a secrets manager; rotate it if it was ever valid.",
      "pattern": "(?i)\\b[\\w.\\-]*(password|passwd|pwd|secret|api[_\\-]?key|access[_\\-]?token|auth[_\\-]?token|client[_\\-]?secret|private[_\\-]?key)[\\w\\-]*[\\\"']?\\s*[:=]\\s*[\\\"'](?P<secret>[^\\\"'\\s]{8,})[\\\"']",
      "secret": true,
      "entropy_min": 3.0,
      "exclude_files": [
        "package-lock.json",
        "yarn.lock",
        "pnpm-lock.yaml",
        "*.lock",
        "go.sum",
        "*.svg",
        "*.min.js",
        "*.map",
        "*.md",
        "*.rst",
        "*.txt"
      ],
      "cwe": [
        "CWE-798"
      ],
      "owasp": [
        "A07:2021"
      ],
      "description": "Heuristic: variable name suggests a secret and the literal has non-trivial entropy. Confirm manually."
    }
  ]
}
