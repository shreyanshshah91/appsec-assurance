                "precision": "medium"
              }
            },
            {
              "id": "CFG-ENV-FILE-PRESENT",
              "name": "EnvironmentFileWithValuesInRepository",
              "shortDescription": {
                "text": "Environment file with values in repository"
              },
              "fullDescription": {
                "text": "Environment file with values in repository"
              },
              "help": {
                "text": "Do not commit .env files; add them to .gitignore, commit a placeholder .env.example, and rotate any real values.",
                "markdown": "Do not commit .env files; add them to .gitignore, commit a placeholder .env.example, and rotate any real values."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
