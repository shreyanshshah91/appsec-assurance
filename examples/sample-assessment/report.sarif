                  "external/cwe/cwe-538",
                  "A05:2021"
                ],
                "security-severity": "5.5",
                "precision": "medium"
              }
            },
            {
              "id": "CFG-EXPRESS-NO-HELMET",
              "name": "ExpressAppWithoutSecurityHeadersMiddleware",
              "shortDescription": {
                "text": "Express app without security headers middleware"
              },
              "fullDescription": {
                "text": "Express app without security headers middleware"
              },
              "help": {
                "text": "Add helmet (or equivalent explicit headers: CSP, HSTS, X-Content-Type-Options, frame-ancestors).",
