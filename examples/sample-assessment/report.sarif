{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "appsec-assurance",
          "version": "1.0.0",
          "informationUri": "https://github.com/OWNER/appsec-assurance",
          "rules": [
            {
              "id": "AUTH-JWT-DECODE-NO-VERIFY-JS",
              "name": "JsonwebtokenDecodeDoesNotVerifySignatures",
              "shortDescription": {
                "text": "jsonwebtoken decode() does not verify signatures"
              },
              "fullDescription": {
                "text": "jsonwebtoken decode() does not verify signatures"
              },
              "help": {
                "text": "Use jwt.verify(token, key, { algorithms: [...] }) for any trust decision.",
                "markdown": "Use jwt.verify(token, key, { algorithms: [...] }) for any trust decision."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-347",
                  "A07:2021"
                ],
                "security-severity": "5.5",
                "precision": "low"
              }
            },
            {
              "id": "AUTH-JWT-HARDCODED-SECRET",
              "name": "JwtSignedVerifiedWithHardcodedSecret",
              "shortDescription": {
                "text": "JWT signed/verified with hardcoded secret"
              },
              "fullDescription": {
                "text": "JWT signed/verified with hardcoded secret"
              },
              "help": {
                "text": "Load signing keys from a secrets manager; prefer asymmetric keys; rotate the exposed secret.",
                "markdown": "Load signing keys from a secrets manager; prefer asymmetric keys; rotate the exposed secret."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-798",
                  "external/cwe/cwe-321",
                  "A07:2021"
                ],
                "security-severity": "8.0",
                "precision": "medium"
              }
            },
            {
              "id": "AUTH-MASS-ASSIGNMENT",
              "name": "RequestBodyBoundDirectlyToAModel",
              "shortDescription": {
                "text": "Request body bound directly to a model"
              },
              "fullDescription": {
                "text": "Request body bound directly to a model"
              },
              "help": {
                "text": "Bind an explicit allowlist of fields (DTO/serializer fields/strong params); never let clients set role, owner, price, or tenant.",
                "markdown": "Bind an explicit allowlist of fields (DTO/serializer fields/strong params); never let clients set role, owner, price, or tenant."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/cwe/cwe-915",
                  "A01:2021",
                  "API3:2023"
                ],
                "security-severity": "5.5",
                "precision": "medium"
              }
            },
            {
              "id": "CFG-CORS-WILDCARD",
              "name": "CorsAllowsAnyOrigin",
              "shortDescription": {
                "text": "CORS allows any origin"
              },
              "fullDescription": {
                "text": "CORS allows any origin"
              },
              "help": {
                "text": "Allow an explicit list of trusted origins; never combine wildcard/reflection with credentials.",
                "markdown": "Allow an explicit list of trusted origins; never combine wildcard/reflection with credentials."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
